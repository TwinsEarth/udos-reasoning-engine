#!/usr/bin/env bash
# UDOS Engine 命令行包装器（macOS / Linux）。
# 通过 bin/udos-env.py 复用“用户主目录下的共享虚拟环境”，多个 UDOS 版本只装一次 torch。
# 可用环境变量 UDOS_VENV 指定自定义环境路径。
set -e
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# 选择一个可用的基础 Python（仅用于引导，真正运行在共享 venv 内）
if command -v python3 >/dev/null 2>&1; then BASE="$(command -v python3)";
elif command -v python >/dev/null 2>&1; then BASE="$(command -v python)";
else echo "[UDOS] 未找到 python3，请先安装 Python 3.10+。" >&2; exit 1; fi

# ensure 的进度打印到 stdout，最后一行是 venv 的 python 路径
PY="$( "$BASE" "$ROOT/bin/udos-env.py" ensure | tail -n 1 )"
if [ -z "$PY" ] || [ ! -x "$PY" ]; then
  echo "[UDOS] 共享环境引导失败，回退系统 Python。" >&2
  PY="$BASE"
fi

cd "$ROOT"
exec "$PY" -m udos7.cli "$@"
